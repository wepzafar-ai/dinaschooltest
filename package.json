{
  "name": "dinaschool-test-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node backend/src/server.js",
    "start:railway": "node backend/src/server.js",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "railway:build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend"
  }
